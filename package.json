{
  "$comment": "SPDX-FileCopyrightText: 2026 maninblack; SPDX-License-Identifier: Apache-2.0",
  "name": "brake-health-cloud",
  "version": "0.1.0",
  "private": true,
  "aosedgeDemo": {"mockCleanupProtocol": "isolated-mock-v1"},
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "26.0.0",
    "npm": "11.12.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/clean.mjs && tsc -p apps/backend/tsconfig.build.json --pretty false && vite build --config apps/dashboard/vite.config.ts",
    "dev": "node tools/dev.mjs",
    "quality": "node tools/quality-gate.mjs",
    "test": "node tools/clean.mjs && tsc -p apps/backend/tsconfig.build.json --pretty false && node --test apps/backend/test/*.test.mjs && vitest run --config tests/vitest.config.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
